# For local hot-reload dev (npm run dev / npm run watch, outside Docker) —
# copy to .env when working this way. Note the host is `localhost:5433`
# here, not `homehold-db:5432` like .env.example: outside Docker there's no
# Docker network to resolve that hostname, so it talks to the port
# docker-compose.yml publishes homehold-db on instead.
PORT=6101
DATABASE_URL=postgresql://homehold:change-me@localhost:5433/homehold?schema=public
JWT_SIGN_KEY=change-me
