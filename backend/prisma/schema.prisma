// Prisma schema for the shared Homehold Postgres database.
//
// This database is intended to be shared across all pet projects hosted
// under homehold.website. For now it only holds the `User` model needed
// for future auth work (see CLAUDE.md roadmap). When a second pet project
// needs its own tables, decide table-prefix vs. Postgres schema-per-project
// before adding more models here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String?  @unique
  passwordHash String?
  isGuest      Boolean  @default(false)
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
