# Copy to .env and fill in real values before running docker compose.
# DATABASE_URL's password must match root .env's POSTGRES_PASSWORD exactly
# — Postgres only applies POSTGRES_PASSWORD on first init of an empty
# volume, so if these two ever drift apart, the backend fails to
# authenticate against an already-initialized DB (see CLAUDE.md).
PORT=6101
DATABASE_URL=postgresql://homehold:change-me@homehold-db:5432/homehold?schema=public
JWT_SIGN_KEY=change-me
